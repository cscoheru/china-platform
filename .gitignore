# ===== OS / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# ===== Node =====
node_modules/
.next/
out/
.pnpm-store/

# ===== Build / Dist =====
build/
dist/
target/

# ===== 数据层（按 PRD 9.2 原始资料不可变；处理产物不入库） =====
# data/raw/ 原始资料按规范应该入对象存储；本仓库只保留样本 + 提取产物
# 已下载的原始文件在 data/raw/ 不进 git（小样本 spike 除外）
data/raw/01-national-yearbook/*.xlsx
data/raw/01-national-yearbook/*.xls
data/raw/02-provincial-yearbook/*.xlsx
data/raw/02-provincial-yearbook/*.xls
data/raw/03-municipal-bulletin/*.pdf
data/raw/04-scanned-pdf/*.pdf
data/extracts/*/raw/
data/processed/*/

# ===== 敏感（PRD 11.5：密钥不进入仓库） =====
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials/

# ===== 日志 =====
*.log
logs/
# 例外：DDL 执行证据与机器生成的证据包必须入库（返工指令八）
!schema/migrations/*.log
!evidence/**

# ===== 临时 =====
*.tmp
*.bak
*.orig

# ===== OCR / 模型 cache =====
.tesseract-cache/
*.traineddata

# ===== Prisma / SQL dumps =====
*.sql.gz
*.dump

# ===== 大型 PDF/Excel（>10MB spike 用 git-lfs，否则不进） =====
*.pdf
*.xlsx
*.xls
!docs/**/*.pdf
# 返工指令四/八：四类真实样本原件必须 git-tracked（clean clone 可重建产物）
!spikes/**/*.xlsx
!spikes/**/*.zip
!spikes/**/*.pdf
# 注意：00-provincial 预解压的 .xls 不 track —— 测试必须从 ZIP 原件自行解压（返工指令四-1/2）
.gstack/

# ===== Explicit excludes (overrides above broad un-ignore) =====
# P-2: 1909 美国统计摘要不入库（archive.org 等级 S3，非中国代表性；31M 体积）
spikes/04-scanned-pdf/statistical_abstract_foreign_countries_1909.pdf
# 返工指令 §6：wall-clock 字段不入库；改用 commit_timestamp_utc
spikes/04-scanned-pdf/.fetch_time_1909.txt
# R4-1：tracked-ZIP-only；测试必须从 ZIP 自行解压（不消费预解压产物）
spikes/00-provincial-yearbook-table/data/extracted/

# ===== 研究 Agent 临时缓存（不入库，研究 Agent 自己读写） =====
.firecrawl/

# ===== dbt (S1.9) =====
# 真实凭证不入库（PRD 11.5 / Cursor 72 §SCHEMA 决策）
dbt/profiles.yml
# dbt 运行时产物（target 已在上面 Build/Dist 排除；这里冗余列出）
dbt/target/
dbt/dbt_packages/
dbt/logs/
# dbt auto-generated user ID
dbt/.user.yml
