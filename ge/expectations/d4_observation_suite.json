{
  "expectation_suite_name": "d4_observation_suite",
  "ge_cloud_id": null,
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_ordered_list",
      "kwargs": {
        "column_list": [
          "observation_id",
          "indicator_id",
          "geo_entity_id",
          "calendar_period_id",
          "value",
          "raw_value",
          "unit",
          "is_imputed",
          "missing_reason",
          "value_type",
          "status",
          "comparison_basis",
          "source_id",
          "ingestion_run_id",
          "extraction_method",
          "confidence",
          "period_start",
          "period_end",
          "period_label",
          "period_type",
          "lineage",
          "extracted_at"
        ],
        "result_format": "BASIC"
      },
      "meta": {"notes": "Schema drift guard for the fact table"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "observation_id", "mostly": 0.99, "result_format": "BASIC"},
      "meta": {"notes": "PK"}
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {"column": "observation_id", "result_format": "BASIC"},
      "meta": {"notes": "PK uniqueness"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "indicator_id", "mostly": 0.99, "result_format": "BASIC"},
      "meta": {"notes": "FK"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "geo_entity_id", "mostly": 0.99, "result_format": "BASIC"},
      "meta": {"notes": "FK"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "source_id", "mostly": 0.99, "result_format": "BASIC"},
      "meta": {"notes": "FK to source_document — docs/10 §2.1"}
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "value_type",
        "value_set": ["FACT", "DERIVED", "INFERENCE", "JUDGMENT"],
        "result_format": "BASIC"
      },
      "meta": {"notes": "stg_observation filters FACT only"}
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "extraction_method",
        "value_set": [
          "API",
          "HTML_PARSE",
          "EXCEL_PARSE",
          "PDF_TEXT",
          "PDF_OCR",
          "IMAGE_OCR",
          "CSV_PARSE",
          "MANUAL_UPLOAD"
        ],
        "result_format": "BASIC"
      },
      "meta": {"notes": "Enum from cegr.extraction_method"}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "confidence",
        "min_value": 0.0,
        "max_value": 1.0,
        "mostly": 0.80,
        "result_format": "BASIC"
      },
      "meta": {"notes": "[0,1] when present"}
    },
    {
      "expectation_type": "expect_column_pair_values_a_to_be_greater_than_b",
      "kwargs": {
        "column_A": "period_end",
        "column_B": "period_start",
        "or_equal": true,
        "mostly": 0.99,
        "result_format": "BASIC"
      },
      "meta": {"notes": "Migration 004 invariant — both NULL OK, but end ≥ start"}
    },
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {"min_value": 0, "max_value": 100000000, "result_format": "BASIC"},
      "meta": {"notes": "Empty-table honest"}
    },
    {
      "expectation_type": "expect_column_unique_value_count_to_be_between",
      "kwargs": {
        "column": "indicator_id",
        "min_value": 0,
        "mostly": 0.10,
        "result_format": "BASIC"
      },
      "meta": {"notes": "Inventory cardinality proxy"}
    }
  ],
  "data_asset_type": null,
  "meta": {
    "citations": [
      {
        "citation_date": "2026-08-25",
        "comment": "Per docs/25 §2 D4 + §7.1 docs/10 §2.1/§2.4 (missing_with_reason)"
      }
    ]
  }
}
