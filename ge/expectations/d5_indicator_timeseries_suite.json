{
  "expectation_suite_name": "d5_indicator_timeseries_suite",
  "ge_cloud_id": null,
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_ordered_list",
      "kwargs": {
        "column_list": [
          "indicator_id",
          "geo_entity_id",
          "period_start",
          "period_end",
          "period_type",
          "value",
          "unit",
          "status",
          "comparison_basis",
          "source_domain",
          "source_category",
          "source_level",
          "verification_status",
          "extraction_method",
          "confidence",
          "extracted_at"
        ],
        "result_format": "BASIC"
      },
      "meta": {"notes": "Schema drift guard for int_indicator_timeseries"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "indicator_id", "mostly": 0.99, "result_format": "BASIC"},
      "meta": {"notes": "Join key"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "geo_entity_id", "mostly": 0.99, "result_format": "BASIC"},
      "meta": {"notes": "Join key"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "value", "result_format": "BASIC"},
      "meta": {"notes": "int_indicator_timeseries filters value IS NOT NULL"}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "value",
        "min_value": -1e15,
        "max_value": 1e15,
        "result_format": "BASIC"
      },
      "meta": {"notes": "Sanity bound; rejects nonsense like 1e30"}
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "source_level",
        "value_set": ["S1", "S2", "S3", "S4", "S5"],
        "result_format": "BASIC"
      },
      "meta": {"notes": "S1-S5 enum (no NULL allowed — int view filters)"}
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "verification_status",
        "value_set": ["VERIFIED", "PARTIAL", "UNVERIFIED", "REJECTED"],
        "result_format": "BASIC"
      },
      "meta": {"notes": "Enum from cegr.source_verification_status"}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "confidence",
        "min_value": 0.0,
        "max_value": 1.0,
        "mostly": 0.80,
        "result_format": "BASIC"
      },
      "meta": {"notes": "[0,1]"}
    },
    {
      "expectation_type": "expect_column_pair_values_a_to_be_greater_than_b",
      "kwargs": {
        "column_A": "period_end",
        "column_B": "period_start",
        "or_equal": true,
        "mostly": 0.99,
        "result_format": "BASIC"
      },
      "meta": {"notes": "Period validity invariant"}
    },
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {"min_value": 0, "max_value": 100000000, "result_format": "BASIC"},
      "meta": {"notes": "Empty-table honest"}
    }
  ],
  "data_asset_type": null,
  "meta": {
    "citations": [
      {
        "citation_date": "2026-08-25",
        "comment": "Per docs/25 §2 D5; backs S1.10 API core endpoint /api/indicator/{id}/series"
      }
    ]
  }
}
