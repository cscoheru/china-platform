# .env.example — Stage 1 / S1.1 local dev
#
# Copy to .env (gitignored) and adjust. NEVER commit a real .env.
# Used by:
#   * infra/docker-compose.yml (POSTGRES_PASSWORD is required by the compose)
#   * alembic/env.py (DATABASE_URL)
#   * scripts/build_evidence_pack.py (read indirectly via PG* env vars)
#
# Stage 0 dev rig: homebrew postgresql@17 on 127.0.0.1:55440, db=cegr_test,
# user=postgres, password=postgres (per docs/12 §9). Production uses different
# values supplied by deploy pipeline; this file is dev-only.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55440
POSTGRES_DB=cegr_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Alembic / SQLAlchemy URL (used by alembic/env.py and any Python clients)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:55440/cegr_test